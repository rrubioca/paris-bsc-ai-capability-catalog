{
  "name": "paris-bsc-catalog-portal",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test test/*.test.mjs",
